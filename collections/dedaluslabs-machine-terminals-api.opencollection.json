              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List terminals"
        },
        {
          "info": {
            "name": "Create terminal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dedaluslabs.ai/v1/machines/:machine_id/terminals",
            "headers": [
              {
                "name": "X-Dedalus-Org-Id",
