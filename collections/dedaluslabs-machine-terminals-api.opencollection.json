        },
        {
          "info": {
            "name": "Connect to terminal WebSocket stream",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dedaluslabs.ai/v1/machines/:machine_id/terminals/:terminal_id/stream",
            "headers": [
              {
                "name": "X-Dedalus-Org-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "machine_id",
                "value": "",
                "type": "path",
                "description": "Machine identifier."
              },
              {
                "name": "terminal_id",
                "value": "",
                "type": "path",
                "description": "Terminal identifier."
              }
            ]
          },
          "docs": "Upgrades to a WebSocket connection for interactive terminal I/O. Clients send JSON `TerminalClientEvent` messages and receive JSON `TerminalServerEvent` messages. Terminal byte streams are base64-encoded inside `input` and `output` events; `resize` events use integer `width` and `height` fields."
        }
      ]
    }
