                "name": "X-Dedalus-Org-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "machine_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "terminal_id",
                "value": "",
                "type": "path"
              }
            ]
          },
